      <aliases enabled='yes' />
      <column datatype='integer' name='[2019-2023 Distress Score (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='0' formula='[2019-2023 Distress Score]' peg='0' size='2.3' />
      </column>
      <column datatype='real' name='[2019-2023 Distress Score]' role='measure' type='quantitative' />
      <column caption='Distressed' datatype='string' name='[Calculation_1001910216649424896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Quintile (5=Distressed)] &gt; 3 then &quot;Yes&quot; else &quot;No&quot; end' />
      </column>
      <column caption='Distress Rural Interaction' datatype='string' name='[Calculation_1001910216653811714]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [County Type] == &quot;Rural&quot; THEN &#10;    if [2019-2023 Distress Score] &gt; 80 THEN&#10;        &quot;Rural Distressed&quot;&#10;    ELSE        &#10;        &quot;Rural Ok&quot;&#10;    END&#10;ELSE &#10;    if [2019-2023 Distress Score] &gt; 80 THEN&#10;        &quot;Not Rural Distressed&quot;&#10;    ELSE        &#10;        &quot;Not Rural Ok&quot;&#10;    END &#10;&#10;END' />
      </column>
      <column datatype='string' name='[Census Region]' role='dimension' type='nominal' />
      <column caption='County Name' datatype='string' name='[County - Split 1]' role='dimension' semantic-role='[County].[Name]' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.15u2zhi1vtjtqk1fzf1f71jcjytu].[County]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [County], &quot;,&quot;, 1 ) )' />
      </column>
      <column caption='FIP' datatype='string' name='[County ID]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
      <column datatype='string' name='[County Type (group)]' role='dimension' type='nominal'>
        <calculation class='categorical-bin' column='[County Type]' new-bin='true'>
          <bin default-name='false' value='&quot;City&quot;'>
            <value>&quot;Large urban&quot;</value>
            <value>&quot;Mid-sized urban&quot;</value>
            <value>&quot;Suburban&quot;</value>
          </bin>
          <bin default-name='false' value='&quot;Rural or small&quot;'>
            <value>&quot;Rural&quot;</value>
            <value>&quot;Small town&quot;</value>
            <value>&quot;Small urban&quot;</value>
          </bin>
        </calculation>
      </column>
      <column datatype='string' name='[County Type]' role='dimension' semantic-role='' type='nominal' />
      <column datatype='string' hidden='true' name='[County]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
      <column aggregation='Avg' datatype='real' name='[Latitude Center N]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
      <column aggregation='Avg' datatype='real' name='[Longitude Center N]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' />
