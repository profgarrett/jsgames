      <column caption='Score Decile Ceiling' datatype='integer' name='[Calculation_792915042543366145]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ceiling( ([2019-2023 Distress Score]+0.001) / 10 )*10' />
