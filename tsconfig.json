{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Excelfun React Application",

	/* ts-node (used by `npm run startnode` via nodemon) must run the server as
	   CommonJS. The top-level "module": "preserve" below is for type-checking
	   the webpack-bundled client; if ts-node uses it, it treats src/server/*.ts
	   as ESM, which breaks extensionless imports and .ts loading. */
	"ts-node": {
		"transpileOnly": true,
		"compilerOptions": {
			"module": "commonjs",
			"moduleResolution": "node"
		}
	},

	"compilerOptions": {
	  "lib": ["dom", "dom.iterable", "esnext"],
	  "module": "preserve",
	  "target": "es2015",
	  "rootDir": "./src",
  
	  // Pin to node10 approach. 
	   "ignoreDeprecations": "6.0",
	   "moduleResolution": "node10",
	   
	  "allowJs": true,
	  "allowSyntheticDefaultImports": true,
	  "esModuleInterop": true,
	  "forceConsistentCasingInFileNames": true,
	  "isolatedModules": true,
	  "jsx": "react-jsx",
	  "noEmit": true,
	  "noFallthroughCasesInSwitch": true,
	  "resolveJsonModule": true,
	  "skipLibCheck": true,
	  "strict": true,
	  "noImplicitAny": false

	}
  }