    "update:low-risk:sql": "npm install --save sql-formatter@^15.8.2 sql.js@^1.14.1",
    "update:low-risk:ui": "npm install --save bootstrap@^5.3.8",
    "update:low-risk:server": "npm install --save bcryptjs@^3.0.3 cookie-session@^2.1.1 mysql2@^3.23.0",
    "update:low-risk:all": "npm run update:low-risk:babel && npm run update:low-risk:build && npm run update:low-risk:sql && npm run update:low-risk:ui && npm run update:low-risk:server",
    "update:medium-risk:linting": "npm install --save-dev @eslint/js@^9.39.5 eslint@^9.39.5 && npm install --save eslint-plugin-react-hooks@^7.1.1 typescript@^5.9.3 typescript-eslint@^8.64.0",
    "update:medium-risk:icons": "npm install --save @fortawesome/free-solid-svg-icons@^7.3.1 @fortawesome/react-fontawesome@^0.2.6",
    "update:medium-risk:types": "npm install --save @types/node@^24.13.3 @types/react@^19.2.17 @types/react-dom@^19.2.3",
    "update:medium-risk:all": "npm run update:medium-risk:linting && npm run update:medium-risk:icons && npm run update:medium-risk:types",
    "update:high-risk:react": "npm install --save react@^19.2.7 react-dom@^19.2.7 react-router@^7.18.1 react-router-dom@^7.18.1 @types/react@^19.2.17 @types/react-dom@^19.2.3",
    "update:high-risk:mailing": "npm install --save nodemailer@^9.0.3 react-qr-code@^2.2.0",
    "update:high-risk:all": "npm run update:high-risk:react && npm run update:high-risk:mailing"
  },
  "browserslist": [
    "last 1 version",
    "> 1%",
    "IE 10"
