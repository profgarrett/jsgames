    "deployA": "webpack --config webpack.production.config.js",
    "startreact": "webpack-dev-server --hot --config ./webpack.config.js --static build",
    "startnode": "nodemon src/server/app.ts --watch src --presets @babel/preset-env --inspect",
    "update:low-risk:babel": "npm install --save-dev @babel/cli@^7.29.7 @babel/core@^7.29.7 @babel/preset-env@^7.29.7 @babel/preset-react@^7.29.7 @babel/preset-typescript@^7.29.7",
